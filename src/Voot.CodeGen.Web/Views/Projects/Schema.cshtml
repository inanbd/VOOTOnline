@model SchemaViewModel
@using Voot.CodeGen.Domain.Schema
@using Voot.CodeGen.Application.Models
@{
    var project = Model.Structure.Project;
    var tables = Model.Structure.Tables;
    ViewData["Title"] = $"Schema · {project.Name}";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h4 mb-1">Database structure</h1>
        <div class="small-muted">
            <a asp-action="Details" asp-route-id="@project.Id">@project.Name</a>
            &middot; <span class="mono">@project.ConnectionStringSummary</span>
            &middot; @tables.Count table@(tables.Count == 1 ? "" : "s")
            &middot; read just now
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.HasSelection)
        {
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-sample-for="__all__" data-sample-title="Sample inserts for @Model.Structure.Selected.Count table(s)">
                Sample inserts
            </button>
        }
        <a asp-action="Schema" asp-route-id="@project.Id" asp-route-all="true" class="btn btn-outline-secondary btn-sm">
            Show all tables
        </a>
        <a asp-action="Details" asp-route-id="@project.Id" class="btn btn-outline-secondary btn-sm">Back to project</a>
    </div>
</div>

@if (Model.Structure.MissingTables.Count > 0)
{
    <div class="alert alert-warning">
        No longer in the database:
        <span class="mono">@string.Join(", ", Model.Structure.MissingTables)</span>.
        They may have been dropped or renamed since this link was made.
    </div>
}

@{
    var change = Model.LastChange;
}

@if (change is not null)
{
    if (change.Succeeded)
    {
        <div class="card">
            <h2>SQL applied &mdash; @change.Diff.Summary()</h2>
            <div class="card-body">
                <div class="small-muted mb-2">
                    @change.Execution.BatchesExecuted batch(es), @change.Execution.RowsAffected row(s) affected.
                    The structure below already reflects it.
                </div>

                @if (!change.Diff.HasChanges)
                {
                    <span class="muted">The script ran but did not alter any table structure.</span>
                }
                else
                {
                    <div class="diff">
                        @foreach (var added in change.Diff.AddedTables)
                        {
                            <div class="diff-row diff-add">
                                <span class="diff-mark">+</span>
                                <span class="mono">table @added.QualifiedName</span>
                                <span class="small-muted">@added.Columns.Count column(s)</span>
                            </div>
                        }
                        @foreach (var dropped in change.Diff.RemovedTables)
                        {
                            <div class="diff-row diff-remove">
                                <span class="diff-mark">&minus;</span>
                                <span class="mono">table @dropped.QualifiedName</span>
                            </div>
                        }
                        @foreach (var t in change.Diff.ChangedTables)
                        {
                            foreach (var c in t.AddedColumns)
                            {
                                <div class="diff-row diff-add">
                                    <span class="diff-mark">+</span>
                                    <span class="mono">@t.TableName.@c.Name</span>
                                    <span class="small-muted mono">@SchemaComparer.Describe(c)</span>
                                </div>
                            }
                            foreach (var c in t.RemovedColumns)
                            {
                                <div class="diff-row diff-remove">
                                    <span class="diff-mark">&minus;</span>
                                    <span class="mono">@t.TableName.@c.Name</span>
                                </div>
                            }
                            foreach (var c in t.ChangedColumns)
                            {
                                <div class="diff-row diff-alter">
                                    <span class="diff-mark">~</span>
                                    <span class="mono">@t.TableName.@c.ColumnName</span>
                                    <span class="small-muted mono">@c.Before &rarr; @c.After</span>
                                </div>
                            }
                        }
                    </div>

                    <div class="small-muted mt-2">
                        The generated code is unchanged until you regenerate.
                        <form asp-controller="Runs" asp-action="Regenerate" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="projectId" value="@project.Id" />
                            Regenerate
                            <button type="submit" name="scope" value="@GenerationScope.ChangedTables"
                                    class="btn btn-link btn-sm p-0 align-baseline">changed tables</button>
                            or
                            <button type="submit" name="scope" value="@GenerationScope.AllTables"
                                    class="btn btn-link btn-sm p-0 align-baseline">all tables</button>.
                        </form>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            <strong>The SQL failed.</strong>
            <div class="mt-1">@change.Change.ErrorMessage</div>
            <div class="small mt-1">
                @if (change.Change.ErrorNumber is { } number)
                {
                    <span>SQL Server error @number</span>
                }
                @if (change.Change.ErrorLineNumber is { } line)
                {
                    <span>, line @line</span>
                }
                @if (change.Execution.FailedBatchIndex is { } batch)
                {
                    <span>, batch @(batch + 1)</span>
                }
                &middot; nothing was applied@(project.Settings.UseTransactionForSql ? " (rolled back)" : "").
            </div>
        </div>
    }
}

<div class="card">
    <h2>Run SQL against this database</h2>
    <div class="card-body">
        <form asp-action="RunSql" asp-route-id="@project.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="all" value="@Model.SelectAll.ToString().ToLowerInvariant()" />
            @foreach (var name in Model.SelectedNames)
            {
                <input type="hidden" name="table" value="@name" />
            }

            <div class="row g-2 mb-2">
                <div class="col-md-5">
                    <input type="text" name="title" class="form-control form-control-sm"
                           value="@Model.Title" placeholder="Title (optional), e.g. Add IsArchived to Invoice" />
                </div>
                <div class="col-md-7 small-muted d-flex align-items-center">
                    Runs against <span class="mono ms-1">@project.ConnectionStringSummary</span>.
                    @(project.Settings.UseTransactionForSql
                        ? "All batches share one transaction."
                        : "Transactions are off for this project.")
                </div>
            </div>

            <textarea name="sqlText" class="form-control sql sql-compact" spellcheck="false"
                      placeholder="ALTER TABLE dbo.tbl_Invoice ADD IsArchived bit NOT NULL DEFAULT (0);&#10;GO">@Model.SqlText</textarea>
            <div class="form-text">
                <code>GO</code> separators are supported. Every script is kept in this project's
                change history, whether it succeeds or fails.
            </div>

            <button type="submit" class="btn btn-primary btn-sm mt-2">Run and show changes</button>
        </form>
    </div>
</div>

@{
    var devPending = Model.DevPending?.Count ?? 0;
    var prodPending = Model.ProductionPending?.Count ?? 0;
}

<div class="card">
    <h2 class="d-flex justify-content-between align-items-center">
        <span>Timeline</span>
        <span class="tracker-actions">
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-sample-for="__dev__" data-sample-title="Pending for development (@devPending change(s))">
                Dev script
                <span class="count-badge @(devPending > 0 ? "count-due" : "")">@devPending</span>
            </button>
            <form asp-action="MarkAllDeployed" asp-route-id="@project.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Mark all @devPending outstanding change(s) as reaching development?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="environment" value="@DeploymentEnvironment.Development" />
                <input type="hidden" name="all" value="@Model.SelectAll.ToString().ToLowerInvariant()" />
                @foreach (var name in Model.SelectedNames)
                {
                    <input type="hidden" name="table" value="@name" />
                }
                <button type="submit" class="btn btn-outline-secondary btn-sm" disabled="@(devPending == 0)">
                    Mark all dev
                </button>
            </form>

            <span class="tracker-divider"></span>

            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-sample-for="__prod__" data-sample-title="Pending for production (@prodPending change(s))">
                Production script
                <span class="count-badge @(prodPending > 0 ? "count-due" : "")">@prodPending</span>
            </button>
            <form asp-action="MarkAllDeployed" asp-route-id="@project.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Mark all @prodPending outstanding change(s) as reaching production?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="environment" value="@DeploymentEnvironment.Production" />
                <input type="hidden" name="all" value="@Model.SelectAll.ToString().ToLowerInvariant()" />
                @foreach (var name in Model.SelectedNames)
                {
                    <input type="hidden" name="table" value="@name" />
                }
                <button type="submit" class="btn btn-outline-secondary btn-sm" disabled="@(prodPending == 0)">
                    Mark all production
                </button>
            </form>
        </span>
    </h2>
    <div class="card-body">
        @if (Model.Timeline.Count == 0)
        {
            <span class="muted">Nothing has happened on this project yet.</span>
        }
        else
        {
            <ol class="timeline">
                @foreach (var entry in Model.Timeline)
                {
                    if (entry.Change is { } c)
                    {
                        var applied = c.Status == ChangeRequestStatus.Applied;
                        <li class="tl-item @(applied ? "tl-change" : "tl-failed")">
                            <span class="tl-dot" aria-hidden="true"></span>
                            <div class="tl-body">
                                <div class="tl-head">
                                    <span class="tl-when">@c.SubmittedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                                    <span class="tl-who">@c.SubmittedByUserName</span>
                                    @if (applied)
                                    {
                                        <span class="pill pill-succeeded">applied</span>
                                    }
                                    else if (c.Status == ChangeRequestStatus.Failed)
                                    {
                                        <span class="pill pill-failed">failed</span>
                                    }
                                    else
                                    {
                                        <span class="pill pill-queued">pending</span>
                                    }
                                </div>

                                <div class="tl-title">
                                    @(string.IsNullOrWhiteSpace(c.Title) ? "SQL change" : c.Title)
                                    @if (!string.IsNullOrWhiteSpace(c.StructureSummary))
                                    {
                                        <span class="small-muted">&middot; @c.StructureSummary</span>
                                    }
                                </div>

                                @if (c.Status == ChangeRequestStatus.Failed)
                                {
                                    <div class="small text-danger">@c.ErrorMessage</div>
                                }

                                @if (applied)
                                {
                                    <div class="tl-trackers">
                                        @foreach (var env in new[] { DeploymentEnvironment.Development, DeploymentEnvironment.Production })
                                        {
                                            var on = c.IsDeployedTo(env);
                                            var label = env == DeploymentEnvironment.Development ? "Dev" : "Production";
                                            var boxId = $"dep-{c.Id}-{env}";
                                            <form asp-action="SetDeployment" asp-route-id="@project.Id" method="post"
                                                  class="tracker-form d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="changeId" value="@c.Id" />
                                                <input type="hidden" name="environment" value="@env" />
                                                <input type="hidden" name="deployed" value="@((!on).ToString().ToLowerInvariant())" />
                                                <input type="hidden" name="all" value="@Model.SelectAll.ToString().ToLowerInvariant()" />
                                                @foreach (var name in Model.SelectedNames)
                                                {
                                                    <input type="hidden" name="table" value="@name" />
                                                }
                                                <label class="tracker @(on ? "tracker-on" : "")" for="@boxId">
                                                    <input type="checkbox" id="@boxId" checked="@on" />
                                                    <span>@label</span>
                                                    @if (on)
                                                    {
                                                        <span class="tracker-meta">
                                                            @c.DeployedUtc(env)!.Value.ToLocalTime().ToString("MMM d")
                                                            @if (!string.IsNullOrWhiteSpace(c.DeployedBy(env)))
                                                            {
                                                                <span>&middot; @c.DeployedBy(env)</span>
                                                            }
                                                        </span>
                                                    }
                                                </label>
                                            </form>
                                        }
                                    </div>
                                }

                                <details class="mt-1">
                                    <summary class="small-muted">SQL</summary>
                                    <pre class="detail">@c.SqlText</pre>
                                </details>
                            </div>
                        </li>
                    }
                    else if (entry.Deployment is { } d)
                    {
                        var toProd = d.Environment == DeploymentEnvironment.Production;
                        var undone = d.Action == DeploymentAction.Unmarked;
                        <li class="tl-item @(toProd ? "tl-prod" : "tl-dev") @(undone ? "tl-undo" : "")">
                            <span class="tl-dot" aria-hidden="true"></span>
                            <div class="tl-body">
                                <div class="tl-head">
                                    <span class="tl-when">@d.MarkedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                                    <span class="tl-who">@d.MarkedByUserName</span>
                                </div>
                                <div class="tl-title">
                                    @(undone ? "Taken back out of " : "Moved to ")@(toProd ? "production" : "development")
                                    @if (!string.IsNullOrWhiteSpace(d.ChangeTitle))
                                    {
                                        <span class="small-muted">&middot; @d.ChangeTitle</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                }
            </ol>
        }
    </div>
</div>

<div class="row">
    <div class="col-lg-3">
        <div class="card table-picker">
            <h2>Tables</h2>
            <div class="card-body">
                @if (tables.Count == 0)
                {
                    <span class="muted">This database has no tables.</span>
                }
                else
                {
                    <form asp-action="Schema" method="get" id="picker">
                        <input type="hidden" name="id" value="@project.Id" />

                        <div class="d-flex gap-2 mb-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" data-pick="all">Select all</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" data-pick="none">Clear</button>
                        </div>

                        <input type="search" class="form-control form-control-sm mb-2" id="filter"
                               placeholder="Filter tables" autocomplete="off" aria-label="Filter tables" />

                        <div class="picker-list">
                            @foreach (var table in tables)
                            {
                                <label class="picker-row" data-name="@table.Name.ToLowerInvariant()">
                                    <input type="checkbox" name="table" value="@table.Name"
                                           checked="@(Model.SelectedNames.Contains(table.Name))" />
                                    <span class="picker-name mono">@table.Name</span>
                                    <span class="picker-meta">
                                        @table.ColumnCount
                                        @if (!table.HasPrimaryKey)
                                        {
                                            <span class="no-pk" title="No primary key: the generator skips this table">!</span>
                                        }
                                    </span>
                                </label>
                            }
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm w-100 mt-2">Show structure</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        @if (!Model.HasSelection)
        {
            <div class="card">
                <div class="card-body">
                    <p class="mb-1">Pick one or more tables to see their structure.</p>
                    <p class="small-muted mb-0">
                        Tick them individually, or use <strong>Select all</strong>. A
                        <span class="no-pk">!</span> marks a table with no primary key, which the
                        generator skips.
                    </p>
                </div>
            </div>
        }

        @foreach (var table in Model.Structure.Selected)
        {
            var className = Model.Names.ClassName(table);
            var isMapping = Model.Names.IsMappingTable(table);

            <div class="card">
                <h2 class="d-flex justify-content-between align-items-center">
                    <span class="mono">@table.QualifiedName</span>
                    <span class="table-tags">
                        <button type="button" class="btn btn-outline-secondary btn-xs"
                                data-sample-for="@table.Name" data-sample-title="Sample INSERT for @table.QualifiedName">
                            Sample insert
                        </button>
                        <span class="pill pill-queued" title="Class name the generator derives">@className</span>
                        @if (isMapping)
                        {
                            <span class="pill pill-running" title="Generated against BaseRelationData, with no manager">junction</span>
                        }
                        @if (!table.HasPrimaryKey)
                        {
                            <span class="pill pill-failed" title="The generator skips tables without a primary key">no primary key</span>
                        }
                    </span>
                </h2>
                <div class="card-body p-0">
                    <table class="data schema-columns">
                        <thead>
                            <tr>
                                <th style="width:2.5rem">#</th>
                                <th>Column</th>
                                <th>Type</th>
                                <th style="width:5rem">Null</th>
                                <th>Default</th>
                                <th>Keys</th>
                            </tr>
                        </thead>
                        <tbody>
                        @{ var position = 0; }
                        @foreach (var column in table.Columns)
                        {
                            var fk = SchemaDisplay.ForeignKeyFor(table, column);
                            var def = SchemaDisplay.Default(column);
                            position++;
                            @* The position in the table, not sys.columns.column_id, which keeps
                               gaps after a DROP COLUMN and would read as a missing column. *@
                            <tr>
                                <td class="small-muted">@position</td>
                                <td class="mono">@column.Name</td>
                                <td class="mono small-muted">@SchemaDisplay.SqlType(column)</td>
                                <td class="small-muted">@(column.AllowDbNull ? "yes" : "no")</td>
                                <td class="mono small-muted">@(def ?? "—")</td>
                                <td>
                                    @foreach (var trait in SchemaDisplay.Traits(column))
                                    {
                                        <span class="trait trait-@trait.ToLowerInvariant()">@trait</span>
                                    }
                                    @if (fk is not null)
                                    {
                                        <a class="fk-target mono"
                                           asp-action="Schema" asp-route-id="@project.Id"
                                           asp-route-table="@fk.PrimaryKeyTableName"
                                           title="Show @fk.PrimaryKeyTableName">
                                            → @fk.PrimaryKeyTableName
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>

                    <div class="schema-extras">
                        <div>
                            <div class="extras-label">Primary key</div>
                            @if (table.PrimaryKey is { } pk)
                            {
                                <div class="mono">@SchemaDisplay.ColumnList(pk.MemberColumns)</div>
                                <div class="small-muted">@pk.Name@(pk.IsComposite ? " (composite)" : "")</div>
                            }
                            else
                            {
                                <span class="muted">none</span>
                            }
                        </div>

                        <div>
                            <div class="extras-label">Foreign keys</div>
                            @if (table.ForeignKeys.Count == 0)
                            {
                                <span class="muted">none</span>
                            }
                            else
                            {
                                @foreach (var fk in table.ForeignKeys)
                                {
                                    <div class="mono">
                                        @SchemaDisplay.ColumnList(fk.ForeignKeyMemberColumns)
                                        →
                                        <a asp-action="Schema" asp-route-id="@project.Id" asp-route-table="@fk.PrimaryKeyTableName">@fk.PrimaryKeyTableName</a>(@SchemaDisplay.ColumnList(fk.PrimaryKeyMemberColumns))
                                    </div>
                                    <div class="small-muted mb-1">@fk.Name</div>
                                }
                            }
                        </div>

                        <div>
                            <div class="extras-label">Indexes</div>
                            @if (table.Indexes.Count == 0)
                            {
                                <span class="muted">none</span>
                            }
                            else
                            {
                                @foreach (var index in table.Indexes)
                                {
                                    <div class="mono">@index.Name</div>
                                    <div class="small-muted mb-1">
                                        @SchemaDisplay.ColumnList(index.MemberColumns)
                                        @(index.IsUnique ? " · unique" : "")@(index.IsClustered ? " · clustered" : "")@(index.IsPrimaryKey ? " · primary key" : "")
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* Payloads for the modal. Rendered as escaped text and read back with textContent, so a
   table name, column name or script cannot break out of the markup. *@
<div class="d-none" id="sample-store">
    @foreach (var table in Model.Structure.Selected)
    {
        <pre data-sample="@table.Name">@SampleInsertBuilder.Build(table)</pre>
    }
    @if (Model.HasSelection)
    {
        <pre data-sample="__all__">@SampleInsertBuilder.Build(Model.Structure.Selected)</pre>
    }
    @if (Model.DevPending is { } devScript)
    {
        <pre data-sample="__dev__">@devScript.Sql</pre>
    }
    @if (Model.ProductionPending is { } prodScript)
    {
        <pre data-sample="__prod__">@prodScript.Sql</pre>
    }
</div>

@{
    var modalBlock = true;
}
@if (modalBlock)
{
    <div class="modal fade" id="sample-modal" tabindex="-1" aria-labelledby="sample-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="sample-modal-title">Sample insert</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <pre class="detail sample-sql" id="sample-sql"></pre>
                </div>
                <div class="modal-footer justify-content-between">
                    <span class="small-muted" id="sample-copy-status" role="status" aria-live="polite"></span>
                    <span>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary btn-sm" id="sample-copy">Copy</button>
                    </span>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Select all / clear act on the rows the filter currently shows, so filtering then
        // selecting all picks what you can see rather than the whole database.
        (function () {
            const form = document.getElementById('picker');
            if (!form) { return; }

            const rows = Array.from(form.querySelectorAll('.picker-row'));
            const filter = document.getElementById('filter');

            const visible = () => rows.filter(r => !r.hidden);

            form.querySelectorAll('[data-pick]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const checked = button.dataset.pick === 'all';
                    visible().forEach(r => { r.querySelector('input').checked = checked; });
                });
            });

            filter.addEventListener('input', function () {
                const term = filter.value.trim().toLowerCase();
                rows.forEach(r => { r.hidden = term.length > 0 && !r.dataset.name.includes(term); });
            });
        })();

        // A tracker checkbox submits its own form, so the pending counts and the timeline
        // refresh together rather than drifting out of step with the server.
        (function () {
            document.querySelectorAll('.tracker-form input[type=checkbox]').forEach(function (box) {
                box.addEventListener('change', function () {
                    box.closest('form').submit();
                });
            });
        })();

        // Sample INSERT modal, with copy-to-clipboard.
        (function () {
            const store = document.getElementById('sample-store');
            const modalEl = document.getElementById('sample-modal');
            if (!store || !modalEl) { return; }

            const modal = new bootstrap.Modal(modalEl);
            const sqlEl = document.getElementById('sample-sql');
            const titleEl = document.getElementById('sample-modal-title');
            const statusEl = document.getElementById('sample-copy-status');

            document.querySelectorAll('[data-sample-for]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const source = store.querySelector('[data-sample="' + button.dataset.sampleFor + '"]');
                    if (!source) { return; }

                    sqlEl.textContent = source.textContent;
                    titleEl.textContent = button.dataset.sampleTitle || 'Sample insert';
                    statusEl.textContent = '';
                    modal.show();
                });
            });

            document.getElementById('sample-copy').addEventListener('click', async function () {
                const text = sqlEl.textContent;

                try {
                    await navigator.clipboard.writeText(text);
                    statusEl.textContent = 'Copied to the clipboard.';
                } catch {
                    // The Clipboard API needs a secure context; fall back to selecting the text
                    // so the statement can still be copied by hand.
                    const range = document.createRange();
                    range.selectNodeContents(sqlEl);
                    const selection = window.getSelection();
                    selection.removeAllRanges();
                    selection.addRange(range);
                    statusEl.textContent = 'Selected — press Ctrl/Cmd+C to copy.';
                }
            });
        })();
    </script>
}
