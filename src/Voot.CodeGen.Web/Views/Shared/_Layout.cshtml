<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; Voot CodeGen</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="brand" asp-controller="Home" asp-action="Index">Voot <span>CodeGen</span></a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="d-flex align-items-center gap-3">
                    <a asp-controller="Home" asp-action="Index">Projects</a>
                    @if (User.IsInRole(RoleNames.Administrator))
                    {
                        <a asp-controller="Users" asp-action="Index">Users</a>
                        <a asp-controller="Projects" asp-action="Create">New project</a>
                    }
                    <span class="divider"></span>
                    <a asp-controller="Account" asp-action="ChangePassword" class="muted">@User.Identity!.Name</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
                    </form>
                </nav>
            }
        </div>
    </header>

    <main class="container py-4">
        @if (TempData["Status"] is string status)
        {
            <div class="alert alert-success">@status</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            Generates the CodeSmith data layer from a SQL Server schema.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
