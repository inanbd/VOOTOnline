@model CreateUserViewModel
@{
    ViewData["Title"] = "New user";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <h2>New user</h2>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label"></label>
                        <input asp-for="DisplayName" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">At least 12 characters, with upper case, lower case and a digit.</div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="IsAdministrator" class="form-check-input" />
                        <label asp-for="IsAdministrator" class="form-check-label"></label>
                        <div class="form-text">
                            Administrators create projects, set connection strings, assign users and manage accounts.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Create user</button>
                    <a asp-action="Index" class="btn btn-link">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
